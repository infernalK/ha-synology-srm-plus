  "options": {
    "step": {
      "init": {
        "title": "Options",
        "data": {
          "track_all": "Track every client",
          "tracked_clients": "Track only these clients",
          "safe_access": "Use Safe Access (parental control)"
        },
        "data_description": {
          "track_all": "Creates a presence entity for every device the router knows, including new ones.",
          "tracked_clients": "Pick the devices that get a presence entity (like the built-in integration). Ignored when every client is tracked. The full client list stays available as attributes of the connection sensors.",
          "safe_access": "Reads the Safe Access profiles and creates their entities. Turn it off if you do not use Safe Access: the calls are no longer made and the existing Safe Access entities are deleted."
        }
      }
    }
  },
  "services": {
    "explore_api": {
      "name": "Explore router APIs",
      "description": "Calls the read-only get/list methods of the router APIs and writes what answers to the Home Assistant log (INFO, custom_components.synology_srm_plus). Takes a few minutes; never calls methods that write.",
      "fields": {
        "filter": {
          "name": "Filter",
          "description": "Only explore APIs whose name contains this text (for example Wifi or Firewall)."
        }
      }
    }
  },
  "issues": {
    "certificate_changed": {
      "title": "The router's certificate changed",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Trust the new certificate?",
            "description": "The certificate presented by {host} is not the one seen when it was set up. This is normal after SRM renewed its certificate or after a reset; if you did neither, someone on your network may be answering in place of the router. Nothing has stopped working. Choose Submit only if you know why it changed: Home Assistant will then remember the new certificate."
          }
        }
      }
    },
    "auto_block_off": {
      "title": "Auto block is off on {router}",
      "description": "SRM's auto block, which blocks an address after repeated failed sign-ins, is switched off on {router}. Switch it on in SRM's security settings (Control Panel). This is only a warning: nothing was changed for you. You can ignore it if it is on purpose."
    },
    "firewall_open": {
      "title": "The firewall of {router} lets the internet into your network",
      "description": "The default firewall policy of {router} allows traffic from the internet to your local network. Unless you made this choice on purpose, set the default policy for traffic from the internet to deny in SRM's firewall settings. This is only a warning: nothing was changed for you."
    }
  }
}
